# ══════════════════════════════════════════════════════════════
#  Sales Platform — Variáveis de Ambiente
#  Copie para .env e preencha os valores
#  Mínimo obrigatório: ANTHROPIC_API_KEY + JWT_SECRET
# ══════════════════════════════════════════════════════════════

# ─── Banco de dados (Docker local) ───────────────────────────
# Sobe com: docker-compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_platform

# ─── Redis (Docker local) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Anthropic — OBRIGATÓRIO ─────────────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI — memória semântica (opcional) ───────────────────
# https://platform.openai.com/api-keys
# Sem isso a memória longa fica desativada, resto funciona
OPENAI_API_KEY=sk-...

# ─── JWT ─────────────────────────────────────────────────────
# Gere: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-secreta-de-32-chars
JWT_EXPIRY=7d

# ─── Servidor ────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── WhatsApp — opcional ──────────────────────────────────────
# Ativa com: docker-compose --profile whatsapp up -d
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=changeme
EVOLUTION_INSTANCE_NAME=comercial

# ─── Bitrix24 — opcional ──────────────────────────────────────
BITRIX24_DOMAIN=https://suaempresa.bitrix24.com.br
BITRIX24_WEBHOOK_TOKEN=
BITRIX24_WEBHOOK_SECRET=

# ─── Email — opcional ─────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=notificacoes@suaempresa.com.br

# ─── Sync ─────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
INACTIVITY_THRESHOLD_DAYS=3
