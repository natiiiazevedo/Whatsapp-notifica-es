# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Database (Supabase) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Bitrix24 ────────────────────────────────────────────────
BITRIX24_DOMAIN=https://yourdomain.bitrix24.com.br
BITRIX24_WEBHOOK_TOKEN=your_webhook_token
BITRIX24_USER_ID=1
# Webhook secret para validar eventos recebidos do Bitrix24
BITRIX24_WEBHOOK_SECRET=your_secret

# ─── WhatsApp (Evolution API) ────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=comercial

# ─── Email ───────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=notificacoes@suaempresa.com.br

# ─── Auth (JWT) ──────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# ─── API ─────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# ─── Embeddings (OpenAI - para memória vetorial) ─────────────
OPENAI_API_KEY=sk-...

# ─── Sync ────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
INACTIVITY_THRESHOLD_DAYS=3
